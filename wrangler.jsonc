{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "rico-community",

  "main": "./src/index.js",

  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/telegram/*"
    ]
  },

  "vars": {
    "APP_NAME": "Rico Club",
    "APP_TIMEZONE": "America/Sao_Paulo"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rico-community-db",
      "database_id": "YOUR_EXISTING_DATABASE_ID"
    }
  ]
}

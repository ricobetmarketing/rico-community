{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "rico-community",

  "main": "./src/index.js",

  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/telegram/*"
    ]
  },

 "vars": {
    "ADMIN_EMAIL": "marketing@rico.bet",
    "APP_NAME": "Rico Club",
    "APP_TIMEZONE": "America/Sao_Paulo",
    "MINI_APP_URL": "https://rico-community.marketing-696.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rico-community-db",
      "database_id": "336be588-5be8-460b-95cd-eed67b28f4bc"
    }
  ]
}
